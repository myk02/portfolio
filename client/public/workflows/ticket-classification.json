{
  "name": "Support Ticket Classification with AI",
  "nodes": [
    {
      "id": "uuid-040-webhook-trigger",
      "name": "Incoming Ticket Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "options": {}
      },
      "webhookId": "YOUR_WEBHOOK_ID"
    },
    {
      "id": "uuid-041-ai-classify",
      "name": "AI Classify Ticket",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.7,
      "position": [300, 300],
      "parameters": {
        "resource": "text",
        "operation": "complete",
        "model": "gpt-4o-mini",
        "prompt": "=Classify this support ticket:\n\nSubject: {{$json.subject}}\nMessage: {{$json.message}}\nCustomer: {{$json.customer_email}}\n\nReturn JSON with:\n- sentiment: positive/neutral/negative\n- priority: low/medium/high/critical\n- category: billing/technical/feature_request/general\n- summary: one-line summary\n- suggested_response: brief response template",
        "options": {
          "temperature": 0.3,
          "maxTokens": 500
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL",
          "name": "OpenAI API"
        }
      }
    },
    {
      "id": "uuid-042-process-ai",
      "name": "Process AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300],
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst cleaned = raw.replace(/^```json\\s*/i, '').replace(/```$/i, '').trim();\nlet classification;\ntry {\n  classification = JSON.parse(cleaned);\n} catch (e) {\n  classification = {\n    sentiment: 'neutral',\n    priority: 'medium',\n    category: 'general',\n    summary: cleaned,\n    suggested_response: 'We will look into this.'\n  };\n}\nconst ticket = $('Incoming Ticket Webhook').first().json;\nreturn [{\n  json: {\n    ...ticket,\n    ...classification,\n    processed_at: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "uuid-043-priority-router",
      "name": "Route by Priority",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [900, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "cond-critical",
              "leftValue": "={{$json.priority}}",
              "rightValue": "critical",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "uuid-044-send-critical-email",
      "name": "Alert Critical Ticket",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1200, 200],
      "parameters": {
        "fromEmail": "support-bot@yourcompany.com",
        "toEmail": "escalation@yourcompany.com",
        "subject": "=CRITICAL Ticket: {{$json.subject}}",
        "emailType": "text",
        "message": "=Priority: CRITICAL\nCategory: {{$json.category}}\nSentiment: {{$json.sentiment}}\n\nCustomer: {{$json.customer_email}}\nSummary: {{$json.summary}}\n\nSuggested Response:\n{{$json.suggested_response}}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CREDENTIAL",
          "name": "SMTP"
        }
      }
    },
    {
      "id": "uuid-045-update-status",
      "name": "Update Ticket Status",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1200, 400],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "field-1",
              "name": "ticket_id",
              "value": "={{$json.id}}",
              "type": "string"
            },
            {
              "id": "field-2",
              "name": "status",
              "value": "classified",
              "type": "string"
            },
            {
              "id": "field-3",
              "name": "priority",
              "value": "={{$json.priority}}",
              "type": "string"
            },
            {
              "id": "field-4",
              "name": "category",
              "value": "={{$json.category}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Incoming Ticket Webhook": {
      "main": [[{"node": "AI Classify Ticket", "type": "main", "index": 0}]]
    },
    "AI Classify Ticket": {
      "main": [[{"node": "Process AI Response", "type": "main", "index": 0}]]
    },
    "Process AI Response": {
      "main": [[{"node": "Route by Priority", "type": "main", "index": 0}]]
    },
    "Route by Priority": {
      "main": [
        [
          {"node": "Alert Critical Ticket", "type": "main", "index": 0},
          {"node": "Update Ticket Status", "type": "main", "index": 0}
        ],
        [
          {"node": "Update Ticket Status", "type": "main", "index": 0}
        ]
      ]
    }
  },
  "pinData": {},
  "versionId": "55555555-5555-5555-5555-555555555555",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [],
  "id": "TICKET_CLASSIFICATION_006",
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
