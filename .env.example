# Client (Vite — VITE_ prefix required, shipped to the browser)
VITE_CONVEX_URL=

# Optional — privacy-friendly analytics. Loads Plausible only when set;
# otherwise the site ships zero tracking. Use the production domain.
# VITE_PLAUSIBLE_DOMAIN=mikeships.vercel.app

# Server (Convex actions — never shipped to the browser)
CONVEX_DEPLOY_KEY=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=mikegary201@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Canonical URL (code source of truth is client/src/lib/site.ts SITE_URL)
SITE_URL=https://mikeships.vercel.app

# AI demo (Partner & Proposal Assistant) — mock mode by default, no key needed.
# Public only: endpoint + model. NEVER put secrets in VITE_ vars (they ship to the browser).
# VITE_AI_DEMO_MODE=mock
# VITE_AI_DEMO_BASE_URL=https://openrouter.ai/api/v1
# VITE_AI_DEMO_MODEL=
# Export integration is OFF by default; enable only with scoped credentials.
# VITE_AI_EXPORT_ENABLED=false
